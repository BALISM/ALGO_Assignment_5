1 0 0 1 50 525.89 Tm (1: Queue Q <- empty; Visited <- empty set; Parent <- empty map) Tj
1 0 0 1 50 511.89 Tm (2: Q.enqueue\(s0\); Visited.add\(key\(s0\)\); Parent[key\(s0\)] <- null) Tj
1 0 0 1 50 497.89 Tm (3: while Q is not empty do) Tj
1 0 0 1 50 483.89 Tm (4:     s <- Q.dequeue\(\)) Tj
